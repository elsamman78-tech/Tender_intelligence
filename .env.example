ZERO_COST_MODE=true
DISCOVERY_ENABLED=true
DDG_HTML_ENABLED=true
DISCOVERY_SCAN_INTERVAL_MINUTES=360
OPEN_DISCOVERY_INTERVAL_MINUTES=720
# Continuous source doctor: audits the least-recently checked sources in rotating batches.
SOURCE_HEALTH_AUDIT_INTERVAL_MINUTES=360
SOURCE_HEALTH_AUDIT_BATCH=30
# Each query fans out to every available zero-cost provider. Keep this moderate.
DISCOVERY_QUERY_BATCH=8
DISCOVERY_MAX_RESULTS_PER_QUERY=15
DISCOVERY_REQUEST_TIMEOUT=20
AUTO_PROMOTE_TENDERS=true
# Persistent data root. On the agreed Windows setup use: E:\Pro\Tenders
# The SQLite database will then be: <TENDER_DATA_HOME>\data\tenders.db
TENDER_DATA_HOME=
# Leave DATABASE_URL blank to use SQLite at TENDER_DATA_HOME/data/tenders.db.
# Set it only when intentionally using another database, for example PostgreSQL.
DATABASE_URL=
# DATABASE_URL=postgresql+psycopg://tender:tender@127.0.0.1:5432/tender_intelligence
# Run START_SEARXNG_WINDOWS.bat to populate this automatically.
SEARXNG_URL=
# Optional adapter only; disabled by default and never required by core.
AGENT_REACH_ENABLED=false
AGENT_REACH_SEARCH_COMMAND=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Local tool-calling agents. If Ollama/model is unavailable, the supervisor uses a bounded deterministic fallback.
AUTONOMOUS_AGENTS_ENABLED=true
AUTONOMOUS_AGENT_MAX_CYCLES=2
# Autonomous supervisor cadence; minimum enforced value is 60 minutes.
AUTONOMOUS_AGENT_INTERVAL_MINUTES=720
TIMEZONE=Africa/Cairo
MAX_UPLOAD_MB=50
