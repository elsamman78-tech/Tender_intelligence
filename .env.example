ZERO_COST_MODE=true
DISCOVERY_ENABLED=true
DDG_HTML_ENABLED=true
DISCOVERY_SCAN_INTERVAL_MINUTES=360
OPEN_DISCOVERY_INTERVAL_MINUTES=720
# Each query fans out to every available zero-cost provider. Keep this moderate.
DISCOVERY_QUERY_BATCH=8
DISCOVERY_MAX_RESULTS_PER_QUERY=15
DISCOVERY_REQUEST_TIMEOUT=20
AUTO_PROMOTE_TENDERS=true
# Run START_SEARXNG_WINDOWS.bat to populate this automatically.
SEARXNG_URL=
# Optional adapter only; disabled by default and never required by core.
AGENT_REACH_ENABLED=false
AGENT_REACH_SEARCH_COMMAND=
# Zero-setup local database uses SQLite. For office PostgreSQL, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://tender:tender@127.0.0.1:5432/tender_intelligence
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
TIMEZONE=Africa/Cairo
MAX_UPLOAD_MB=50
