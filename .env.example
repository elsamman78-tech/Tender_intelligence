ZERO_COST_MODE=true
DISCOVERY_ENABLED=true
DDG_HTML_ENABLED=true
DISCOVERY_SCAN_INTERVAL_MINUTES=360
OPEN_DISCOVERY_INTERVAL_MINUTES=720
DISCOVERY_QUERY_BATCH=8
DISCOVERY_MAX_RESULTS_PER_QUERY=15
DISCOVERY_REQUEST_TIMEOUT=20
AUTO_PROMOTE_TENDERS=true
# Optional local self-hosted search. Leave blank if not installed.
SEARXNG_URL=
# Optional Agent-Reach integration. Agent-Reach routes upstream tools; no paid backend is required by core.
AGENT_REACH_ENABLED=true
AGENT_REACH_SEARCH_COMMAND=
# Zero-setup demo uses SQLite. For office PostgreSQL, uncomment and edit:
# DATABASE_URL=postgresql+psycopg://tender:tender@127.0.0.1:5432/tender_intelligence
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
TIMEZONE=Africa/Cairo
MAX_UPLOAD_MB=50
