# Core policy
ZERO_COST_MODE=true
DISCOVERY_ENABLED=true
AUTO_PROMOTE_TENDERS=true

# Cloud defaults
DDG_HTML_ENABLED=true
DISCOVERY_SCAN_INTERVAL_MINUTES=360
OPEN_DISCOVERY_INTERVAL_MINUTES=720
DISCOVERY_QUERY_BATCH=8
DISCOVERY_MAX_RESULTS_PER_QUERY=15
DISCOVERY_REQUEST_TIMEOUT=20

# Optional providers
SEARXNG_URL=
AGENT_REACH_ENABLED=false
AGENT_REACH_SEARCH_COMMAND=

# Local AI is optional in the first free-cloud deployment.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# Database: SQLite persists in ./data by default.
# DATABASE_URL=sqlite:////app/data/tenders.db
# Later PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://tender:CHANGE_ME@postgres:5432/tender_intelligence

TIMEZONE=Africa/Cairo
MAX_UPLOAD_MB=50

# Never commit a real token. Copy this file to .env on the server.
CLOUDFLARE_TUNNEL_TOKEN=
